"""
Módulo de autenticación para la aplicación "100%LIFE".

Este módulo gestiona el registro de nuevos usuarios con contraseñas encriptadas 
mediante hash y la autenticación de credenciales existentes, almacenando los 
datos de manera persistente en un archivo JSON local.
"""

import os
import json
import hashlib


def _hash_password(password: str) -> str:
    """
    Convierte una contraseña en texto plano a su representación hash SHA-256.

    Args:
        password (str): Contraseña en texto plano.

    Returns:
        str: Cadena hexadecimal correspondiente al hash de la contraseña.
    """
    return hashlib.sha256(password.encode('utf-8')).hexdigest()


def _load_database(db_path: str) -> dict:
    """
    Carga la base de datos de usuarios desde un archivo JSON.

    Caso borde gestionado:
    - Si el archivo no existe o está corrupto/vacío, inicializa la estructura 
      por defecto y crea los directorios necesarios.

    Args:
        db_path (str): Ruta del archivo JSON de usuarios.

    Returns:
        dict: Diccionario con la estructura de usuarios de la base de datos.
    """
    # Asegurar que el directorio contenedor exista
    db_dir = os.path.dirname(db_path)
    if db_dir and not os.path.exists(db_dir):
        os.makedirs(db_dir, exist_ok=True)

    # Si el archivo no existe, retornar estructura inicial vacía
    if not os.path.exists(db_path):
        return {"users": {}}

    try:
        with open(db_path, "r", encoding="utf-8") as file:
            data = json.load(file)
            if not isinstance(data, dict) or "users" not in data:
                return {"users": {}}
            return data
    except (json.JSONDecodeError, IOError):
        # Caso borde: Archivo corrupto o con errores de lectura, se reinicia de forma segura
        return {"users": {}}


def _save_database(db_path: str, data: dict) -> None:
    """
    Guarda el diccionario de la base de datos en el archivo JSON especificado.

    Args:
        db_path (str): Ruta del archivo JSON.
        data (dict): Diccionario completo a almacenar.
    """
    with open(db_path, "w", encoding="utf-8") as file:
        json.dump(data, file, indent=4, ensure_ascii=False)


def authenticate_user(username: str, password: str, db_path: str = "data/users.json") -> dict | None:
    """
    Verifica si las credenciales de un usuario coinciden con los registros en la base de datos JSON.

    Args:
        username (str): Nombre de usuario ingresado.
        password (str): Contraseña en texto plano ingresada.
        db_path (str): Ruta al archivo JSON de almacenamiento.

    Returns:
        dict | None: Diccionario con los datos del usuario si las credenciales son válidas, 
                     o None en caso de fallo o credenciales incorrectas.
    """
    # Caso borde: Cadenas vacías o nulas
    if not username or not password:
        return None

    # Limpiar espacios en blanco iniciales y finales
    clean_username = username.strip()
    clean_password = password.strip()

    if not clean_username or not clean_password:
        return None

    # Cargar base de datos
    db = _load_database(db_path)
    users = db.get("users", {})

    # Verificar existencia del usuario
    if clean_username not in users:
        return None

    user_record = users[clean_username]
    stored_password_hash = user_record.get("password_hash", "")

    # Verificar coincidencia de hashes
    input_password_hash = _hash_password(clean_password)

    if input_password_hash == stored_password_hash:
        # Retornar una copia de los datos del usuario (excluyendo el hash por seguridad si se prefiere)
        user_data = user_record.copy()
        return user_data

    return None


def register_user(username: str, password: str, db_path: str = "data/users.json") -> tuple[bool, str]:
    """
    Crea un nuevo registro de usuario con contraseña encriptada y perfil vacío.

    Args:
        username (str): Nombre de usuario deseado.
        password (str): Contraseña en texto plano.
        db_path (str): Ruta al archivo JSON de almacenamiento.

    Returns:
        tuple[bool, str]: Una tupla donde el primer elemento indica éxito (True/False) 
                          y el segundo elemento contiene un mensaje descriptivo o de error.
    """
    # Caso borde: Validación de campos vacíos o con espacios en blanco
    if not username or not password:
        return False, "El usuario y la contraseña no pueden estar vacíos."

    clean_username = username.strip()
    clean_password = password.strip()

    if not clean_username or not clean_password:
        return False, "El usuario y la contraseña no pueden contener únicamente espacios en blanco."

    # Cargar base de datos actual
    db = _load_database(db_path)
    users = db.setdefault("users", {})

    # Caso borde: El nombre de usuario ya existe
    if clean_username in users:
        return False, "El nombre de usuario ya se encuentra registrado. Elige otro."

    # Encriptar contraseña con hashlib (SHA-256)
    password_hash = _hash_password(clean_password)

    # Crear el nuevo registro con perfil y estructuras iniciales vacías
    users[clean_username] = {
        "username": clean_username,
        "password_hash": password_hash,
        "measures": {},
        "schedule": {},
        "exercise_status": "",
        "workouts": []
    }

    try:
        # Guardar los cambios en el archivo JSON
        _save_database(db_path, db)
        return True, "Usuario registrado exitosamente."
    except IOError as e:
        return False, f"Error al guardar los datos en el sistema: {str(e)}"