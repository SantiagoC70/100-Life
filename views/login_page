"""
Módulo de la vista de autenticación y registro para la aplicación "100%LIFE".

Este módulo renderiza la interfaz gráfica en Streamlit para que los usuarios puedan
iniciar sesión con sus credenciales o registrar una cuenta nueva en el sistema.
"""

import streamlit as st
from src.auth import authenticate_user, register_user


def render_login_page() -> None:
    """
    Renderiza la página de inicio de sesión y registro de usuarios en Streamlit.

    Presenta dos pestañas interactivas:
    1. "Iniciar Sesión": Captura el usuario y contraseña, valida mediante src.auth.authenticate_user.
       Si las credenciales son correctas, guarda el usuario en st.session_state['user_data'],
       establece st.session_state['authenticated'] = True y reinicia la app con st.rerun().
    2. "Crear Cuenta": Captura datos para registrar un nuevo usuario con src.auth.register_user.

    Casos borde gestionados:
    - Campos de entrada vacíos o con solo espacios al hacer clic en enviar (muestra st.warning).
    - Credenciales erróneas o nombre de usuario inexistente (muestra st.error).
    - Intento de registro con un nombre de usuario que ya existe (muestra st.error amigable).
    """
    st.markdown("<h1 style='text-align: center;'>Bienvenido a 100%LIFE 🏃‍♂️</h1>", unsafe_allow_html=True)
    st.markdown(
        "<p style='text-align: center; color: gray;'>"
        "Plataforma integral de seguimiento y rendimiento para estudiantes atletas"
        "</p>",
        unsafe_allow_html=True
    )
    st.markdown("---")

    # Crear contenedor centrado usando columnas
    col_left, col_center, col_right = st.columns([1, 2, 1])

    with col_center:
        # Pestañas para conmutar entre Iniciar Sesión y Crear Cuenta
        tab_login, tab_register = st.tabs(["🔑 Iniciar Sesión", "📝 Crear Cuenta"])

        # ------------------------------------------------------------------
        # Pestaña 1: Iniciar Sesión
        # ------------------------------------------------------------------
        with tab_login:
            st.subheader("Ingresa tus credenciales")

            with st.form(key="login_form"):
                username_input = st.text_input("Nombre de usuario", key="login_user")
                password_input = st.text_input("Contraseña", type="password", key="login_pass")
                submit_login = st.form_submit_button("Ingresar", use_container_width=True)

            if submit_login:
                # Caso borde: Campos vacíos o únicamente con espacios
                if not username_input.strip() or not password_input.strip():
                    st.warning("Por favor, ingresa tanto el nombre de usuario como la contraseña.")
                else:
                    # Intentar autenticación con el backend
                    user_data = authenticate_user(
                        username=username_input.strip(),
                        password=password_input.strip()
                    )

                    if user_data:
                        # Éxito: Actualizar el estado global de la sesión
                        st.session_state['authenticated'] = True
                        st.session_state['user_data'] = user_data
                        st.session_state['page'] = 'Dashboard'
                        st.success("¡Inicio de sesión exitoso!")
                        st.rerun()
                    else:
                        # Caso borde: Credenciales incorrectas o usuario no registrado
                        st.error("Nombre de usuario o contraseña incorrectos. Verifica tus datos.")

        # ------------------------------------------------------------------
        # Pestaña 2: Crear Cuenta
        # ------------------------------------------------------------------
        with tab_register:
            st.subheader("Regístrate en 100%LIFE")

            with st.form(key="register_form"):
                new_username_input = st.text_input("Elige un nombre de usuario", key="reg_user")
                new_password_input = st.text_input("Crea una contraseña", type="password", key="reg_pass")
                confirm_password_input = st.text_input("Confirma tu contraseña", type="password", key="reg_pass_conf")
                submit_register = st.form_submit_button("Registrarse", use_container_width=True)

            if submit_register:
                # Caso borde: Campos de registro vacíos
                if not new_username_input.strip() or not new_password_input.strip():
                    st.warning("Todos los campos son obligatorios. Por favor completa la información.")
                # Caso borde: Las contraseñas no coinciden
                elif new_password_input.strip() != confirm_password_input.strip():
                    st.error("Las contraseñas ingresadas no coinciden. Inténtalo de nuevo.")
                else:
                    # Intentar registro mediante el backend
                    success, message = register_user(
                        username=new_username_input.strip(),
                        password=new_password_input.strip()
                    )

                    if success:
                        st.success(f"¡Cuenta creada con éxito! {message}")
                        st.info("Ahora puedes ir a la pestaña 'Iniciar Sesión' e ingresar a la app.")
                    else:
                        # Caso borde: El usuario ya existe u otro error devuelto por la lógica
                        st.error(f"No se pudo crear la cuenta: {message}")